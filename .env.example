# Environment Variables Template
#
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git - it's in .gitignore
#
# Usage: cp .env.example .env

# ============================================
# Application Settings
# ============================================

# Application environment (development, staging, production)
APP_ENV=development

# Application URL
APP_URL=http://localhost:3000

# Application port
PORT=3000

# Debug mode (true/false)
DEBUG=true

# ============================================
# Database Configuration
# ============================================

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_password_here

# Database URL (alternative to individual settings)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ============================================
# API Keys and External Services
# ============================================

# Example API key
API_KEY=your_api_key_here

# Example secret key for JWT or session
SECRET_KEY=your_secret_key_here

# Third-party service credentials
# STRIPE_API_KEY=your_stripe_key
# SENDGRID_API_KEY=your_sendgrid_key
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ============================================
# Authentication
# ============================================

# JWT settings
# JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRATION=3600

# OAuth credentials
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret

# ============================================
# Email Configuration
# ============================================

# SMTP settings
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=noreply@example.com

# ============================================
# Cloud Storage
# ============================================

# S3 or similar storage
# S3_BUCKET=your_bucket_name
# S3_REGION=us-east-1

# ============================================
# Monitoring and Analytics
# ============================================

# Analytics
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Error tracking
# SENTRY_DSN=your_sentry_dsn

# ============================================
# Development/Testing Only
# ============================================

# Test database
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_NAME=test_database

# ============================================
# Notes
# ============================================
#
# Security Best Practices:
# 1. Never commit .env file to version control
# 2. Use strong, unique passwords and keys
# 3. Rotate credentials regularly
# 4. Use different credentials for each environment
# 5. Never share credentials in plain text (email, chat, etc.)
# 6. Consider using a secret management service (AWS Secrets Manager, HashiCorp Vault, etc.)
