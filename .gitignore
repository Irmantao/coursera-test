# ============================================
# SECURITY - Sensitive Files and Credentials
# ============================================

# Environment variables and configuration
.env
.env.*
.env.local
.env.development
.env.production
.env.test
*.env

# Exception: Allow .env.example template files
!.env.example
!**/.env.example

# Configuration files that may contain secrets
config/credentials.yml
config/secrets.yml
config/database.yml
config/production.yml
**/secrets.yaml
**/secrets.yml
**/credentials.json
**/credentials.yaml
**/credentials.yml

# API keys and tokens
**/apikeys.*
**/api-keys.*
**/*-credentials.*
**/*-secrets.*
**/*.secret
**/*.credentials

# SSH and private keys
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/.ssh/*

# SSL certificates
**/*.crt
**/*.cer
**/*.ca-bundle
**/*.p7b
**/*.p7s
**/*.der

# Password files
**/*password*
**/*passwd*
!**/password-utils.* # Allow password utility files but not actual passwords

# Authentication tokens
**/*token*
**/*auth*
!**/auth-utils.* # Allow auth utility files

# Cloud provider credentials
**/.aws/credentials
**/.aws/config
**/.azure/credentials
**/.gcloud/credentials

